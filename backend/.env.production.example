# ==============================================================================
# SAKU BACKEND - PRODUCTION ENVIRONMENT CONFIGURATION
# Disimpan di GitHub Secrets (PROD_ENV_FILE) atau di .env server
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL Local Docker)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://postgres:5432/db_saku?currentSchema=mel_saku
DB_USERNAME=user_saku
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_SCHEMA=mel_saku

# ------------------------------------------------------------------------------
# 2. CACHING & SESSION (Redis Local Docker)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY_PREFIX=mel_saku
REDIS_TIMEOUT=10000ms

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT & OTP)
# ------------------------------------------------------------------------------
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_SECRET
OTP_EXPIRY_MINUTES=5

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION (Frontend Web & Mobile App Origin)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://saku-app-fp.vercel.app,http://localhost:4200,http://35.255.112.244,http://35.255.112.244:8080

# ------------------------------------------------------------------------------
# 5. MAIL NOTIFICATION (Gmail SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
