# ==========================================
# SAKU BACKEND - ENVIRONMENT VARIABLES EXAMPLE
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5433/db_saku
DB_NAME=db_saku
DB_USERNAME=user_saku
DB_PASSWORD=your_database_password
DB_SCHEMA=saku

# 2. AUTHENTICATION & SECURITY (JWT & OTP)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_length
OTP_EXPIRY_MINUTES=5

# 3. CACHING & SESSION (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=saku
REDIS_TIMEOUT=10000ms
REDIS_USERNAME=
REDIS_PASSWORD=

# 4. CORS ALLOWED ORIGINS
CORS_ALLOWED_ORIGINS=https://saku-app-fp.vercel.app,http://localhost:4200,http://localhost:3000

# 5. MAIL SMTP CONFIGURATION (Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
